def kron_gate(gate_2x2, qubit, n_qubits):
    ops = [np.eye(2, dtype=complex)] * n_qubits
    ops[qubit] = gate_2x2
    result = ops[0]
    for op in ops[1:]:
        result = np.kron(result, op)
    return result
