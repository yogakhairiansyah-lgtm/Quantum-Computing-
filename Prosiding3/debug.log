def cnot_full(n_qubits, control, target):
    dim = 2 ** n_qubits
    mat = np.zeros((dim, dim), dtype=complex)
    for j in range(dim):
        ctrl_bit = (j >> (n_qubits - 1 - control)) & 1
        if ctrl_bit:
            tgt_pos = n_qubits - 1 - target
            i = j ^ (1 << tgt_pos)
        else:
            i = j
        mat[i, j] = 1.0
    return mat
