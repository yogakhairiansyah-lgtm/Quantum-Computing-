def optimizer_cl(params, H_mat, n_qubits, n_electrons, history, ansatz_fn, ansatz_kwargs):
    psi = ansatz_fn(params, n_qubits, n_electrons, **ansatz_kwargs)
    E   = expect_value(psi, H_mat)
    history.append(E)
    return E
